# Required for both commands. Use an organization API key with the kh_ prefix.
KEEPERHUB_API_KEY=kh_replace_me

# Optional. Defaults to the hosted KeeperHub app.
KEEPERHUB_BASE_URL=https://app.keeperhub.com

# Defaults to Base Sepolia (84532). The script checks GET /api/chains before use.
CHAIN_ID=84532

# Transfer target and amount. TOKEN_ADDRESS may be omitted for a native-token transfer.
RECIPIENT_ADDRESS=0x0000000000000000000000000000000000000000
TOKEN_ADDRESS=
AMOUNT=0.001

# Default is simulation only. Set to 1 only when intentionally broadcasting.
EXECUTE=0

# Required when EXECUTE=1. Keep this stable across retries of the same work.
TASK_ID=first-write-demo-001

# Optional independent EVM receipt verification.
RPC_URL=

# Mainnet is refused by default. Only set this after intentionally reviewing the request.
ALLOW_MAINNET=0
